{
  "manifest_version": 3,
  "name": "Andrew's Markup — page annotator",
  "version": "1.0.0",
  "description": "Draw on any page with the markup tools, then capture from the top of the page to your lowest annotation straight to the clipboard.",
  "action": { "default_title": "Markup this page" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "web_accessible_resources": [{
    "resources": ["shared/toolbar.css"],
    "matches": ["<all_urls>"]
  }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
